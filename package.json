{
  "name": "trippygo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build && node scripts/prerender.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" \"serverless/**/*.ts\" \"scripts/**/*.{mjs,tsx}\" \"data/**/*.json\" \"docs/**/*.md\" \".github/**/*.yml\" README.md index.html eslint.config.mjs \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" \"serverless/**/*.ts\" \"scripts/**/*.{mjs,tsx}\" \"data/**/*.json\" \"docs/**/*.md\" \".github/**/*.yml\" README.md index.html eslint.config.mjs \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.1",
    "vitest": "^5.0.2"
  }
}
