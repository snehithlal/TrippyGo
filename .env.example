VITE_ADMIN_ROUTE=admin

# Browser-only admin mode for local UI development. Do not use in production.
VITE_LOCAL_ADMIN=true
VITE_LOCAL_ADMIN_PASSWORD=admin

# Leave this empty when testing without the Vercel API.
VITE_CONTENT_API_URL=# Public frontend configuration; VITE_* values are included in the browser bundle.
VITE_ADMIN_ROUTE=your-private-route
VITE_CONTENT_API_URL=https://your-api-deployment.vercel.app/api

# Server-only settings. Configure these in the API host, never in GitHub Pages.
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repository
GITHUB_BRANCH=main
ADMIN_PASSWORD=replace-with-a-long-random-password
GITHUB_TOKEN=replace-with-a-fine-grained-token
SESSION_SECRET=replace-with-a-long-random-session-secret
ALLOWED_ORIGIN=https://your-github-pages-domain
