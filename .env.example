VITE_ADMIN_ROUTE=admin

# Browser-only admin mode for local UI development. Do not use in production.
VITE_LOCAL_ADMIN=true
VITE_LOCAL_ADMIN_PASSWORD=admin

# Leave this empty to use the browser-only local admin adapter.
VITE_CONTENT_API_URL=

# Optional: when testing a real API locally, set VITE_LOCAL_ADMIN=false and
# point VITE_CONTENT_API_URL at the local API. Keep API credentials in a
# separate, untracked local environment file.

# Vercel API reference. Configure these in Vercel's environment settings.
# Keep secrets below out of frontend variables and source control.
# GITHUB_OWNER=snehithlal
# GITHUB_REPO=TrippyGo
# GITHUB_BRANCH=main
# GITHUB_TOKEN=your-fine-grained-github-token
# ADMIN_PASSWORD=your-unique-admin-password
# SESSION_SECRET=generate-with-openssl-rand-base64-32
# ALLOWED_ORIGIN=https://your-public-site-origin

# GitHub Pages frontend variables (Actions Variables, or uncomment for local
# testing against a real API after setting VITE_LOCAL_ADMIN=false).
# VITE_ADMIN_ROUTE=your-private-route
# VITE_CONTENT_API_URL=https://your-vercel-project.vercel.app/api
